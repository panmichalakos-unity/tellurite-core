<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <title>Databricks Cost Doctor — Findings Report</title>
  <style>
    body { font-family: system-ui, sans-serif; max-width: 960px; margin: 2rem auto; color: #222; }
    h1 { color: #c0392b; }
    h2 { border-bottom: 1px solid #ddd; padding-bottom: .25rem; }
    .headline { background: #fdf3f3; border-left: 4px solid #c0392b; padding: 1rem; margin-bottom: 2rem; }
    .headline .total { font-size: 2rem; font-weight: bold; color: #c0392b; }
    table { border-collapse: collapse; width: 100%; margin-bottom: 2rem; }
    th, td { border: 1px solid #ddd; padding: .5rem .75rem; text-align: left; }
    th { background: #f5f5f5; }
    .sev-high { color: #c0392b; font-weight: bold; }
    .sev-medium { color: #e67e22; }
    .sev-low { color: #7f8c8d; }
    .finding-card { border: 1px solid #ddd; border-radius: 6px; padding: 1rem; margin-bottom: 1.5rem; }
    .finding-card h3 { margin-top: 0; }
    .evidence { background: #f9f9f9; padding: .5rem; border-radius: 4px; font-family: monospace; font-size: .85rem; white-space: pre-wrap; }
    .remediation { background: #eafaf1; border-left: 3px solid #27ae60; padding: .5rem .75rem; margin-top: .75rem; }
    .caveat { background: #fefce8; border: 1px solid #f1c40f; padding: .75rem; border-radius: 4px; font-size: .9rem; }
  </style>
</head>
<body>

<h1>Databricks Cost Doctor</h1>
<p style="color:#888">by Akmonlabs &nbsp;|&nbsp; Lookback: {{ lookback_days }} days &nbsp;|&nbsp; Currency: {{ currency }}</p>

<!-- 1. Headline -->
<div class="headline">
  <div class="total">${{ "%.0f"|format(total_waste_usd) }} / month (est.){% if show_savings_pct and total_savings_pct is not none %} &mdash; {{ "%.0f"|format(total_savings_pct * 100) }}% of attributed spend{% endif %}</div>
  <div>{{ findings|length }} findings &mdash;
    <span class="sev-high">{{ n_high }} high</span>,
    <span class="sev-medium">{{ n_medium }} medium</span>,
    <span class="sev-low">{{ n_low }} low</span>
  </div>
</div>

<!-- 2. Top findings table -->
<h2>Top Findings</h2>
{% if findings %}
<table>
  <thead>
    <tr>
      <th>#</th>
      <th>Finding</th>
      <th>Instance</th>
      <th>Est. Waste / Mo</th>
      {% if show_savings_pct %}<th>Savings %</th>{% endif %}
      <th>Severity</th>
      <th>Confidence</th>
      <th>Quick Fix</th>
    </tr>
  </thead>
  <tbody>
    {% for f in findings %}
    <tr>
      <td>{{ loop.index }}</td>
      <td>{{ f.title }}</td>
      <td>{{ f.instance_key }}</td>
      <td><strong>${{ "%.0f"|format(f.monthly_waste_usd) }}</strong></td>
      {% if show_savings_pct %}<td>{% if f.savings_pct is not none %}{{ "%.0f"|format(f.savings_pct * 100) }}%{% else %}&mdash;{% endif %}</td>{% endif %}
      <td class="sev-{{ f.severity }}">{{ f.severity }}</td>
      <td>{{ f.confidence }}</td>
      <td>{{ f.remediation.summary }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>
{% else %}
<p>No findings above the ${{ min_cost_usd }} threshold. Great work!</p>
{% endif %}

<!-- 3. Per-finding detail -->
<h2>Finding Details</h2>
{% for f in findings %}
<div class="finding-card">
  <h3>{{ loop.index }}. {{ f.title }} <small style="color:#888">{{ f.rule_id }}</small></h3>
  <p><strong>Severity:</strong> <span class="sev-{{ f.severity }}">{{ f.severity }}</span> &nbsp;
     <strong>Confidence:</strong> {{ f.confidence }} &nbsp;
     <strong>Est. Waste:</strong> ${{ "%.0f"|format(f.monthly_waste_usd) }}/mo{% if show_savings_pct and f.savings_pct is not none %} ({{ "%.0f"|format(f.savings_pct * 100) }}% of ${{ "%.0f"|format(f.attributed_cost_usd) }} attributed){% endif %}</p>
  <p><strong>Instance:</strong> {{ f.instance_key }}</p>
  <div class="evidence">{{ f.evidence | tojson(indent=2) }}</div>
  <div class="remediation">
    <strong>Fix:</strong> {{ f.remediation.summary }}<br/>
    {% if f.remediation.pr_hint %}<em>{{ f.remediation.pr_hint }}</em>{% endif %}
  </div>
</div>
{% endfor %}

<!-- 5. Methodology & caveats -->
<h2>Methodology &amp; Caveats</h2>
<div class="caveat">
  <ul>
    <li>This report is <strong>read-only</strong>: only <code>SELECT</code> on <code>system.*</code> tables. No business data was accessed.</li>
    <li>Cost figures are <strong>estimated at list price</strong> (<code>system.billing.list_prices</code>). Your effective rate may be lower due to private discounts or commit tiers.{% if discount_pct %} A {{ "%.0f"|format(discount_pct * 100) }}% discount was applied.{% endif %}</li>
    <li>Lookback window: <strong>{{ lookback_days }} days</strong>. Monthly estimates are extrapolated from this window.</li>
    <li><strong>Confidence levels:</strong> High = direct $ evidence; Medium = reliable heuristic; Low = proxy signal requiring manual confirmation.</li>
    <li>No data left your workspace. This report was generated locally.</li>
  </ul>
</div>

<p style="color:#aaa;font-size:.8rem;margin-top:3rem">Generated by Tellurite Cost Doctor &mdash; Akmonlabs</p>
</body>
</html>
