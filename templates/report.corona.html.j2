{#- Corona-themed (dark) Tellurite audit report. Self-contained: the vendored Corona
    stylesheet (Bootstrap 4 + theme) is inlined by report.py so the file opens offline. -#}
{%- macro sev_badge(sev) -%}
  {%- set cls = {"high": "badge-danger", "medium": "badge-warning", "low": "badge-info"}.get(sev, "badge-secondary") -%}
  <span class="badge {{ cls }}">{{ sev }}</span>
{%- endmacro -%}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1, shrink-to-fit=no">
  <title>Tellurite — Databricks Cost Audit</title>
  <style>{{ corona_css|safe }}</style>
  <style>
    /* Tellurite tweaks on top of Corona */
    .tl-brand { font-weight: 700; letter-spacing: .04em; }
    .tl-brand small { color: #6c7293; font-weight: 400; }
    .evidence { font-family: monospace; font-size: .75rem; white-space: pre-wrap; color: #b8bccc;
                background: rgba(0,0,0,.2); padding: .6rem .8rem; border-radius: 4px; }
    .table td, .table th { vertical-align: middle; }
    .tl-detail { border: 1px solid rgba(255,255,255,.08); border-radius: 4px; margin-bottom: .5rem; }
    .tl-detail > summary { cursor: pointer; padding: .6rem .9rem; list-style: none; }
    .tl-detail > summary::-webkit-details-marker { display: none; }
    .tl-detail[open] > summary { border-bottom: 1px solid rgba(255,255,255,.08); }
    .tl-detail-body { padding: .8rem .9rem; }
  </style>
</head>
<body>
  <div class="container-scroller">
    <!-- sidebar -->
    <nav class="sidebar sidebar-offcanvas" id="sidebar">
      <div class="sidebar-brand-wrapper d-none d-lg-flex align-items-center justify-content-center fixed-top">
        <a class="sidebar-brand brand-logo tl-brand" href="#">TELLURITE</a>
        <a class="sidebar-brand brand-logo-mini tl-brand" href="#">T</a>
      </div>
      <ul class="nav">
        <li class="nav-item nav-category">Cost Audit</li>
        <li class="nav-item"><a class="nav-link" href="#overview">
          <span class="menu-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/><rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/></svg></span>
          <span class="menu-title">Overview</span></a></li>
        <li class="nav-item"><a class="nav-link" href="#findings">
          <span class="menu-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></span>
          <span class="menu-title">Findings</span></a></li>
        <li class="nav-item"><a class="nav-link" href="#methodology">
          <span class="menu-icon"><svg viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20"/><path d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z"/></svg></span>
          <span class="menu-title">Methodology</span></a></li>
      </ul>
    </nav>
    <!-- /sidebar -->
    <div class="container-fluid page-body-wrapper">
      <nav class="navbar p-0 fixed-top d-flex flex-row">
        <div class="navbar-brand-wrapper d-flex d-lg-none align-items-center justify-content-center">
          <a class="navbar-brand brand-logo-mini tl-brand" href="#">T</a>
        </div>
        <div class="navbar-menu-wrapper flex-grow d-flex align-items-stretch">
          <ul class="navbar-nav w-100">
            <li class="nav-item">
              <h5 class="mb-0 mt-2 tl-brand">Databricks Cost Audit <small>· by Akmonlabs</small></h5>
            </li>
          </ul>
          <ul class="navbar-nav navbar-nav-right">
            <li class="nav-item d-none d-lg-block">
              <span class="text-muted">Lookback {{ lookback_days }}d · {{ currency }} · {{ generated_at }}</span>
            </li>
          </ul>
        </div>
      </nav>

      <div class="main-panel">
        <div class="content-wrapper">

          <!-- Overview -->
          <div class="row" id="overview">
            <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <div class="row">
                    <div class="col-9">
                      <h3 class="mb-0 text-danger">${{ "{:,.0f}".format(total_waste_usd) }}</h3>
                    </div>
                    <div class="col-3 text-right">
                      <div class="icon icon-box-danger"><span class="icon-item"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="1" x2="12" y2="23"/><path d="M17 5H9.5a3.5 3.5 0 0 0 0 7h5a3.5 3.5 0 0 1 0 7H6"/></svg></span></div>
                    </div>
                  </div>
                  <h6 class="text-muted font-weight-normal">Est. recoverable / mo · {{ n_resources }} resource{{ '' if n_resources == 1 else 's' }}</h6>
                  {% if gross_waste_usd > total_waste_usd %}<small class="text-muted">conservative; overlapping findings sum to ${{ "{:,.0f}".format(gross_waste_usd) }}</small>{% endif %}
                </div>
              </div>
            </div>
            <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <div class="row">
                    <div class="col-9">
                      <h3 class="mb-0">{% if total_savings_pct is not none %}{{ "{:.0f}".format(total_savings_pct * 100) }}%{% else %}—{% endif %}</h3>
                    </div>
                    <div class="col-3 text-right">
                      <div class="icon icon-box-success"><span class="icon-item"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="19" y1="5" x2="5" y2="19"/><circle cx="6.5" cy="6.5" r="2.5"/><circle cx="17.5" cy="17.5" r="2.5"/></svg></span></div>
                    </div>
                  </div>
                  <h6 class="text-muted font-weight-normal">Of attributed spend (discount-invariant)</h6>
                </div>
              </div>
            </div>
            <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <div class="row">
                    <div class="col-9">
                      <h3 class="mb-0">{{ findings|length }}</h3>
                    </div>
                    <div class="col-3 text-right">
                      <div class="icon icon-box-info"><span class="icon-item"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="8" y1="6" x2="21" y2="6"/><line x1="8" y1="12" x2="21" y2="12"/><line x1="8" y1="18" x2="21" y2="18"/><line x1="3" y1="6" x2="3.01" y2="6"/><line x1="3" y1="12" x2="3.01" y2="12"/><line x1="3" y1="18" x2="3.01" y2="18"/></svg></span></div>
                    </div>
                  </div>
                  <h6 class="text-muted font-weight-normal">Dollar findings{% if info_findings %} · {{ info_findings|length }} informational{% endif %}</h6>
                </div>
              </div>
            </div>
            <div class="col-xl-3 col-sm-6 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <div class="row">
                    <div class="col-9">
                      <h3 class="mb-0"><span class="text-danger">{{ n_high }}</span><small class="text-muted"> / {{ n_medium }} / {{ n_low }}</small></h3>
                    </div>
                    <div class="col-3 text-right">
                      <div class="icon icon-box-warning"><span class="icon-item"><svg viewBox="0 0 24 24" width="22" height="22" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg></span></div>
                    </div>
                  </div>
                  <h6 class="text-muted font-weight-normal">High / Medium / Low severity</h6>
                </div>
              </div>
            </div>
          </div>

          <!-- Recoverable by rule (pure-CSS bar chart) -->
          {% if by_rule %}
          <div class="row">
            <div class="col-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title">Recoverable by rule</h4>
                  <p class="text-muted mb-3">Gross monthly $ contributed by each rule (before per-resource de-duplication).</p>
                  {% for title, amt in by_rule %}
                  <div class="mb-3">
                    <div class="d-flex justify-content-between mb-1">
                      <small>{{ title }}</small>
                      <small class="font-weight-medium">${{ "{:,.0f}".format(amt) }}</small>
                    </div>
                    <div class="progress" style="height:10px">
                      <div class="progress-bar bg-info" role="progressbar"
                           style="width: {{ [(amt / by_rule_max * 100) if by_rule_max else 0, 100] | min }}%"></div>
                    </div>
                  </div>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
          {% endif %}

          <!-- Findings table -->
          <div class="row" id="findings">
            <div class="col-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title">Top findings</h4>
                  <p class="text-muted mb-3">Ranked by estimated monthly waste.</p>
                  {% if findings %}
                  <div class="table-responsive">
                    <table class="table table-hover">
                      <thead>
                        <tr>
                          <th>#</th>
                          <th>Finding</th>
                          <th>Instance</th>
                          <th>Category</th>
                          <th class="text-right">$/mo</th>
                          {% if show_savings_pct %}<th>Savings %</th>{% endif %}
                          <th>Severity</th>
                          <th>Confidence</th>
                          <th>Fix</th>
                        </tr>
                      </thead>
                      <tbody>
                        {% for f in findings %}
                        <tr>
                          <td class="text-muted">{{ loop.index }}</td>
                          <td>{{ f.title }}</td>
                          <td><code>{{ f.instance_key }}</code></td>
                          <td><span class="text-muted">{{ f.category }}</span></td>
                          <td class="text-right font-weight-medium">${{ "{:,.0f}".format(f.monthly_waste_usd) }}</td>
                          {% if show_savings_pct %}
                          <td style="min-width:90px">
                            {% if f.savings_pct is not none %}
                            <div class="progress" style="height:6px">
                              <div class="progress-bar bg-success" role="progressbar"
                                   style="width: {{ [ (f.savings_pct * 100) | round(0, 'floor') | int, 100] | min }}%"></div>
                            </div>
                            <small class="text-muted">{{ "{:.0f}".format(f.savings_pct * 100) }}%</small>
                            {% else %}<span class="text-muted">—</span>{% endif %}
                          </td>
                          {% endif %}
                          <td>{{ sev_badge(f.severity) }}</td>
                          <td><span class="text-muted">{{ f.confidence }}</span></td>
                          <td><small>{{ f.remediation.summary }}</small></td>
                        </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                  {% else %}
                  <p class="text-success">No findings above the threshold.</p>
                  {% endif %}
                </div>
              </div>
            </div>
          </div>

          <!-- Per-finding detail / evidence -->
          {% if findings %}
          <div class="row" id="detail">
            <div class="col-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title">Finding details</h4>
                  <p class="text-muted mb-3">Evidence and the recommended fix for each finding. Click to expand.</p>
                  {% for f in findings %}
                  <details class="tl-detail">
                    <summary>
                      <span class="font-weight-medium">{{ loop.index }}. {{ f.title }}</span>
                      <code class="ml-2">{{ f.instance_key }}</code>
                      {{ sev_badge(f.severity) }}
                      <span class="float-right font-weight-medium text-danger">${{ "{:,.0f}".format(f.monthly_waste_usd) }}/mo</span>
                    </summary>
                    <div class="tl-detail-body">
                      <p class="mb-1"><strong>Fix:</strong> {{ f.remediation.summary }}</p>
                      {% if f.remediation.pr_hint %}<p class="text-muted mb-2"><em>{{ f.remediation.pr_hint }}</em></p>{% endif %}
                      <p class="text-muted mb-1">
                        Confidence: {{ f.confidence }} ·
                        {% if f.attributed_cost_usd is not none %}attributed ${{ "{:,.0f}".format(f.attributed_cost_usd) }}/mo{% endif %}
                        {% if f.savings_pct is not none %} · savings {{ "{:.0f}".format(f.savings_pct * 100) }}%{% endif %}
                      </p>
                      <pre class="evidence mb-0">{{ f.evidence | tojson(indent=2) }}</pre>
                    </div>
                  </details>
                  {% endfor %}
                </div>
              </div>
            </div>
          </div>
          {% endif %}

          <!-- Informational (no direct $) -->
          {% if info_findings %}
          <div class="row" id="informational">
            <div class="col-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title">Informational <small class="text-muted">({{ info_findings|length }})</small></h4>
                  <p class="text-muted mb-3">Governance gaps and tuning signals — no direct dollar estimate; review-only.</p>
                  <div class="table-responsive">
                    <table class="table table-hover">
                      <thead><tr><th>Finding</th><th>Instance</th><th>Category</th><th>Note</th></tr></thead>
                      <tbody>
                        {% for f in info_findings %}
                        <tr>
                          <td>{{ f.title }}</td>
                          <td><code>{{ f.instance_key }}</code></td>
                          <td><span class="text-muted">{{ f.category }}</span></td>
                          <td><small>{{ f.remediation.summary }}</small></td>
                        </tr>
                        {% endfor %}
                      </tbody>
                    </table>
                  </div>
                </div>
              </div>
            </div>
          </div>
          {% endif %}

          <!-- Methodology -->
          <div class="row" id="methodology">
            <div class="col-12 grid-margin stretch-card">
              <div class="card">
                <div class="card-body">
                  <h4 class="card-title">Methodology &amp; caveats</h4>
                  <ul class="text-muted">
                    <li><strong>Read-only:</strong> only <code>SELECT</code> on <code>system.*</code>. No business data accessed; nothing left the workspace.</li>
                    <li><strong>Full-TCO list-price basis</strong> (DBU + VM/infra). Your effective rate may be lower via private discounts{% if discount_pct %}; a {{ "{:.0f}".format(discount_pct * 100) }}% discount was applied{% endif %}.</li>
                    <li><strong>Savings %</strong> is discount-invariant — it holds even under promotional/negotiated pricing.</li>
                    <li><strong>Overlap:</strong> a resource can match several rules that target the same spend. The headline takes the largest estimate per resource (conservative); per-rule findings below may overlap.</li>
                    <li><strong>Lookback:</strong> {{ lookback_days }} days. Monthly figures are extrapolated from this window.</li>
                    <li><strong>Confidence:</strong> high = direct $ evidence; medium = reliable heuristic; low = proxy requiring confirmation.</li>
                  </ul>
                </div>
              </div>
            </div>
          </div>

        </div>
        <footer class="footer">
          <div class="d-sm-flex justify-content-center justify-content-sm-between">
            <span class="text-muted text-center text-sm-left d-block d-sm-inline-block">Tellurite Audit — Akmonlabs</span>
            <span class="float-none float-sm-right d-block mt-1 mt-sm-0 text-center text-muted">Generated {{ generated_at }}</span>
          </div>
        </footer>
      </div>
    </div>
  </div>
</body>
</html>
